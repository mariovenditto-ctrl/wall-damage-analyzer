# Application Settings
APP_NAME=WallDamageAnalyzer
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=5000
API_PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./app.db
# For PostgreSQL: postgresql://user:password@localhost:5432/wall_damage_analyzer
DB_ECHO=False

# File Upload Settings
UPLOAD_FOLDER=data/uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,bmp,tiff

# Image Processing Settings
IMAGE_SIZE=512
IMAGE_QUALITY=95
THUMBNAIL_SIZE=256

# Analysis Settings
DAMAGE_THRESHOLD=0.5
MIN_AREA_THRESHOLD=100  # pixels
COLOR_SPACE=HSV

# Dashboard Settings
DASHBOARD_THEME=light
DASHBOARD_PORT=8501

# API Settings
API_VERSION=v1
API_TIMEOUT=300
ENABLE_CORS=True

# Model Settings
MODEL_PATH=data/models/
PRETRAINED_MODEL=resnet50
USE_GPU=True

# Report Settings
REPORT_FORMAT=pdf
REPORT_LANGUAGE=it

# Logging
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=10

# External Services (Optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
